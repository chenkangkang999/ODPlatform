# 相对路径均相对 defect_manage 项目根；只提交本模板，不提交真实.env。
FOOTBALL_DEBUG=true
FOOTBALL_HOST=127.0.0.1
FOOTBALL_PORT=8502
# 同学提供的可信足球权重；不接受网页上传任意.pt文件。
FOOTBALL_MODEL_PATH=
FOOTBALL_MODEL_METADATA=
FOOTBALL_MODEL_LABEL=足球检测模型
FOOTBALL_MODEL_DIR=
FOOTBALL_DEMO_IMAGE_PATH=
FOOTBALL_PLATFORM_ROOT=../ODPlatform
# 指向已安装同学算法依赖的Python；留空使用当前解释器。
FOOTBALL_INFERENCE_PYTHON=
FOOTBALL_DEVICE=cpu
FOOTBALL_MAX_IMAGE_MB=15
FOOTBALL_MAX_VIDEO_MB=200
FOOTBALL_MAX_FRAMES=1500
FOOTBALL_JOB_TIMEOUT=900
# 单独填写，不会自动读取银行项目的.env。
FOOTBALL_LLM_API_KEY=
FOOTBALL_LLM_BASE_URL=https://api.deepseek.com
FOOTBALL_LLM_MODEL=deepseek-flash
FOOTBALL_LLM_TIMEOUT=30
# 可选：实际每百万token单价；留空时费用显示未配置，不能当免费。
FOOTBALL_LLM_INPUT_PRICE_PER_MILLION=
FOOTBALL_LLM_OUTPUT_PRICE_PER_MILLION=
# Event data stays local. Relative paths resolve against the Django repository.
# FOOTBALL_EVENT_DATA_DIR=football_portal/.local/datasets/football_events
FOOTBALL_CAROUSEL_SECONDS=9
FOOTBALL_MONITOR_REFRESH_SECONDS=10
